# Copy this file to .env and replace every placeholder before deploying.
# GO54 production hosting should use MySQL rather than SQLite for persistent data.
NODE_ENV=production
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=alif_foundation
DB_USER=root
DB_PASSWORD=

# App
PORT=5000
BASE_URL=https://your-domain.example
JWT_SECRET=replace_with_a_long_random_secret

# SMTP (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=info@alikpeafoundation.org
